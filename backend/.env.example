# ── OceanHub Backend — Environment Configuration ──────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# Gemini API Key (required for all agents)
GEMINI_API_KEY=your_gemini_api_key_here

# Bybit Testnet credentials (ccxt)
BYBIT_API_KEY=your_bybit_testnet_api_key
BYBIT_API_SECRET=your_bybit_testnet_api_secret

# WebSocket server port (must match Electron frontend)
WS_PORT=8080

# Trading symbol to analyse
SYMBOL=BTC/USDT

# OHLCV timeframe (e.g. 1h, 15m, 4h)
TIMEFRAME=1h

# Number of candles to fetch per cycle
CANDLE_LIMIT=200

# How often to run the analysis cycle (seconds)
CYCLE_INTERVAL=60

# Discord Webhook Notifications
DISCORD_WEBHOOK_URL=
DISCORD_ENABLED=True
